// Divisas — PostgreSQL schema (dominio completo)
// Base: PROJECT_MASTER_SPEC_v1.md §19

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============ ENUMS ============

enum Role {
  CUSTOMER
  CASHIER
  SUPERVISOR
  COMPLIANCE
  TREASURY
  ADMIN
  AUDITOR
}

enum CorridorDirection {
  EC_TO_PE // USD -> PEN
  PE_TO_EC // PEN -> USD
}

enum CustomerType {
  PERSON
  BUSINESS
}

enum DocumentType {
  CEDULA
  DNI
  PASSPORT
  RUC
}

enum TransferStatus {
  DRAFT
  QUOTED
  CONFIRMED
  AWAITING_PAYMENT
  PAYMENT_RECEIVED
  RECONCILIATION
  RISK_CHECK
  APPROVED
  SETTLEMENT_PENDING
  PAYOUT_PROCESSING
  PAID
  COMPLETED

  // Excepcionales
  QUOTE_EXPIRED
  PAYMENT_MISMATCH
  PAYMENT_EXPIRED
  MANUAL_REVIEW
  AML_REVIEW
  RISK_BLOCKED
  PAYOUT_FAILED
  PAYOUT_REJECTED
  CANCELLED
  REFUND_PENDING
  REFUNDED
}

enum PaymentMethod {
  BANK_TRANSFER
  CASH
}

enum PayoutMethod {
  BANK
  CASH
  MOBILE_WALLET
}

enum PaymentStatus {
  PENDING
  RECEIVED
  MATCHED
  MISMATCH
  MANUAL_REVIEW
  EXPIRED
  CANCELLED
}

enum PayoutStatus {
  PENDING
  PROCESSING
  PAID
  FAILED
  REJECTED
  CANCELLED
}

enum CashMovementType {
  OPENING
  CASH_IN
  CASH_OUT
  ADJUSTMENT
  CLOSING
}

enum CashSessionStatus {
  OPEN
  CLOSED
  PENDING_REVIEW
}

enum LedgerAccountType {
  ASSET
  LIABILITY
  INCOME
  EXPENSE
  EQUITY
}

enum LedgerEntrySide {
  DEBIT
  CREDIT
}

enum AuditAction {
  CREATE
  UPDATE
  STATUS_CHANGE
  APPROVE
  REJECT
  BLOCK
  DELETE
  LOGIN
  LOGOUT
  CASH_OPEN
  CASH_CLOSE
  CASH_IN
  CASH_OUT
  PAYMENT_MATCH
  PAYOUT
}

// ============ MAESTROS ============

model Country {
  id            String       @id @default(uuid())
  code          String       @unique // EC, PE
  name          String
  currency      String // USD, PEN
  createdAt     DateTime     @default(now())

  offices       Office[]
  corridorsFrom Corridor[]   @relation("FromCountry")
  corridorsTo   Corridor[]   @relation("ToCountry")
  customers     Customer[]
  beneficiaries Beneficiary[]
  bankAccounts  BankAccount[]
  suppliers     Supplier[]
  employees     Employee[]
}

model Currency {
  id        String   @id @default(uuid())
  code      String   @unique // USD, PEN
  name      String
  decimals  Int      @default(2)
  createdAt DateTime @default(now())
}

model Corridor {
  id           String             @id @default(uuid())
  fromCountryId String
  toCountryId   String
  fromCurrency  String
  toCurrency    String
  direction    CorridorDirection  @unique
  active       Boolean            @default(true)
  createdAt    DateTime           @default(now())

  fromCountry Country  @relation("FromCountry", fields: [fromCountryId], references: [id])
  toCountry   Country  @relation("ToCountry", fields: [toCountryId], references: [id])

  fxRates   FxRate[]
  quotes    Quote[]
  transfers Transfer[]

  @@unique([fromCountryId, toCountryId])
}

model Office {
  id        String   @id @default(uuid())
  name      String
  countryId String
  address   String?
  active    Boolean  @default(true)
  createdAt DateTime @default(now())

  country      Country       @relation(fields: [countryId], references: [id])
  cashAccounts CashAccount[]
  users        User[]
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String
  fullName     String
  role         Role     @default(CUSTOMER)
  phone        String?
  active       Boolean  @default(true)
  lastLoginAt  DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  officeId      String?
  office        Office?           @relation(fields: [officeId], references: [id])
  customer      Customer?
  auditLogs     AuditLog[]
  cashSessionsOpened CashSession[] @relation("SessionOpenedBy")
  cashSessionsClosed CashSession[] @relation("SessionClosedBy")
  cashMovements CashMovement[]
  expensesCreated Expense[] @relation("ExpenseCreatedBy")
  accountTransfersCreated AccountTransfer[] @relation("AccountTransferCreatedBy")
  capitalMovementsCreated CapitalMovement[] @relation("CapitalMovementCreatedBy")
  payrollPaymentsCreated  PayrollPayment[]  @relation("PayrollPaymentCreatedBy")
}

// ============ CLIENTES ============

model Customer {
  id               String       @id @default(uuid())
  userId           String?      @unique
  type             CustomerType
  fullName         String
  documentType     DocumentType
  documentNumber   String
  countryId        String
  email            String?
  phone            String?
  economicActivity String? // Empleado, Comerciante, Independiente, Jubilado, etc.
  kycStatus        String       @default("PENDING") // PENDING | IN_REVIEW | APPROVED | REJECTED
  riskScore        Int          @default(0)
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  user         User?          @relation(fields: [userId], references: [id])
  country      Country        @relation(fields: [countryId], references: [id])
  beneficiaries Beneficiary[]
  transfers    Transfer[]     @relation("Sender")
  documents    Document[]
  riskAlerts   RiskAlert[]
  amlCases     AmlCase[]

  @@unique([documentType, documentNumber])
}

model Document {
  id         String   @id @default(uuid())
  customerId String
  type       String // ID_FRONT, ID_BACK, RUC, PROOF_OF_ADDRESS, etc.
  fileUrl    String
  status     String   @default("PENDING")
  uploadedAt DateTime @default(now())

  customer Customer @relation(fields: [customerId], references: [id])
}

model Beneficiary {
  id             String   @id @default(uuid())
  customerId     String
  fullName       String
  documentType   DocumentType
  documentNumber String
  countryId      String
  phone          String?
  active         Boolean  @default(true)
  createdAt      DateTime @default(now())

  customer  Customer            @relation(fields: [customerId], references: [id])
  country   Country             @relation(fields: [countryId], references: [id])
  accounts  BeneficiaryAccount[]
  transfers Transfer[]          @relation("PayoutBeneficiary")
}

model BeneficiaryAccount {
  id            String   @id @default(uuid())
  beneficiaryId String
  bankName      String
  accountNumber String
  accountType   String? // savings | checking
  currency      String   @default("PEN")
  isDefault     Boolean  @default(false)
  createdAt     DateTime @default(now())

  beneficiary Beneficiary @relation(fields: [beneficiaryId], references: [id])
  transfers   Transfer[]  @relation("PayoutAccount")
}

// ============ FX / COTIZACIÓN ============

model FxRate {
  id               String    @id @default(uuid())
  corridorId       String
  marketRate       Decimal   @db.Decimal(18, 8)
  sellRate         Decimal   @db.Decimal(18, 8) // tasa aplicada al cliente
  spreadBps        Int // spread en puntos básicos
  isManualOverride Boolean   @default(false)
  manualRate       Decimal?  @db.Decimal(18, 8)
  sourceApi        String?   @default("SYSTEM_DEFAULT")
  lastFetchAt      DateTime?
  active           Boolean   @default(true)
  createdAt        DateTime  @default(now())

  corridor Corridor @relation(fields: [corridorId], references: [id])
  quotes   Quote[]
}

model Quote {
  id             String   @id @default(uuid())
  corridorId     String
  fxRateId       String
  sendAmount     Decimal  @db.Decimal(18, 2)
  sendCurrency   String
  feeAmount      Decimal  @db.Decimal(18, 2)
  feeCurrency    String
  fxRate         Decimal  @db.Decimal(18, 8)
  receiveAmount  Decimal  @db.Decimal(18, 2)
  receiveCurrency String
  expiresAt      DateTime
  status         String   @default("ACTIVE") // ACTIVE | EXPIRED | USED | CANCELLED
  createdAt      DateTime @default(now())

  corridor Corridor @relation(fields: [corridorId], references: [id])
  fxRateRef FxRate  @relation(fields: [fxRateId], references: [id])
  transfer Transfer?
}

// ============ TRANSFERENCIAS ============

model Transfer {
  id                 String         @id @default(uuid())
  reference          String         @unique // TRX-XXXXXXXX
  status             TransferStatus @default(DRAFT)
  corridorId         String
  senderId           String
  beneficiaryId      String
  payoutMethod       PayoutMethod
  paymentMethod      PaymentMethod
  quoteId            String?        @unique
  sendAmount         Decimal        @db.Decimal(18, 2)
  sendCurrency       String
  feeAmount          Decimal        @db.Decimal(18, 2)
  feeCurrency        String
  fxRate             Decimal        @db.Decimal(18, 8)
  receiveAmount      Decimal        @db.Decimal(18, 2)
  receiveCurrency    String
  remittanceReason   String? // Ayuda Familiar, Gastos Médicos, Pago Proveedor Comercial, Educación, etc.
  payoutAccountId    String? // cuenta bancaria beneficiario si payout = BANK
  withdrawalCode     String? // código de retiro si payout = CASH
  withdrawalExpiresAt DateTime?
  withdrawalAttempts Int            @default(0)
  withdrawalUsed     Boolean        @default(false)
  riskScore          Int            @default(0)
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt

  corridor        Corridor          @relation(fields: [corridorId], references: [id])
  sender          Customer          @relation("Sender", fields: [senderId], references: [id])
  beneficiary     Beneficiary       @relation("PayoutBeneficiary", fields: [beneficiaryId], references: [id])
  quote           Quote?            @relation(fields: [quoteId], references: [id])
  payoutAccount   BeneficiaryAccount? @relation("PayoutAccount", fields: [payoutAccountId], references: [id])
  events          TransferEvent[]
  payments        Payment[]
  payouts         Payout[]
  settlements     Settlement[]
  riskAssessments RiskAssessment[]
  ledgerEntries   LedgerEntry[]
}

model TransferEvent {
  id         String          @id @default(uuid())
  transferId String
  fromStatus TransferStatus?
  toStatus   TransferStatus
  actorId    String
  note       String?
  createdAt  DateTime        @default(now())

  transfer Transfer @relation(fields: [transferId], references: [id])
}

// ============ PAGOS ============

model Payment {
  id                  String        @id @default(uuid())
  transferId          String
  method              PaymentMethod
  status              PaymentStatus @default(PENDING)
  amount              Decimal       @db.Decimal(18, 2)
  currency            String
  bankName            String?
  accountNumber       String?
  transactionRef      String?
  cashMovementId      String?       @unique
  receivedById        String?
  receivedAt          DateTime?
  referenceCode       String? // código de referencia para verificación
  proofFileUrl        String? // URL/b64 del comprobante de transferencia subido por el cliente
  customerDeclaredRef String? // código TRX-XXXXXX declarado por el cliente
  sourceOfFunds       String? // Sueldo/Honorarios, Ahorros, Venta de Inmueble, Préstamo, etc.
  highBillSerials     String? // Números de serie de billetes de alta denominación recibidos
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt

  transfer     Transfer      @relation(fields: [transferId], references: [id])
  cashMovement CashMovement? @relation("PaymentCashMovement", fields: [cashMovementId], references: [id])
  matches      PaymentMatch[]
}

model PaymentMatch {
  id        String   @id @default(uuid())
  paymentId String
  matched   Boolean  @default(true)
  matchType String // MANUAL | BANK_STATEMENT | CASH
  detail    String?
  createdAt DateTime @default(now())

  payment Payment @relation(fields: [paymentId], references: [id])
}

// ============ PAYOUT ============

model Payout {
  id             String       @id @default(uuid())
  transferId     String
  method         PayoutMethod
  status         PayoutStatus @default(PENDING)
  amount         Decimal      @db.Decimal(18, 2)
  currency       String
  bankName       String?
  accountNumber  String?
  bankRef        String?
  cashMovementId String?      @unique
  processedById  String?
  processedAt    DateTime?
  pickupAt       DateTime?
  note           String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  transfer     Transfer     @relation(fields: [transferId], references: [id])
  cashMovement CashMovement? @relation("PayoutCashMovement", fields: [cashMovementId], references: [id])
}

model Settlement {
  id          String    @id @default(uuid())
  transferId  String
  status      String    @default("PENDING") // PENDING | COMPLETED | FAILED
  method      String    @default("TREASURY")
  amount      Decimal   @db.Decimal(18, 2)
  currency    String
  completedAt DateTime?
  createdAt   DateTime  @default(now())

  transfer Transfer @relation(fields: [transferId], references: [id])
}

// ============ LEDGER (double-entry) ============

model LedgerAccount {
  id      String           @id @default(uuid())
  code    String           @unique
  name    String
  type    LedgerAccountType
  currency String
  balance Decimal          @default(0) @db.Decimal(18, 2)

  entries LedgerEntry[]

  @@index([code])
}

model LedgerEntry {
  id          String           @id @default(uuid())
  accountId   String
  transferId  String?
  entryGroup  String // identificador del asiento (p. ej. TRX-xxx-CASHIN)
  side        LedgerEntrySide
  amount      Decimal          @db.Decimal(18, 2)
  currency    String
  description String
  createdAt   DateTime         @default(now())

  account  LedgerAccount @relation(fields: [accountId], references: [id])
  transfer Transfer?     @relation(fields: [transferId], references: [id])

  @@index([accountId])
  @@index([entryGroup])
}

// ============ BANCOS / CAJA ============

model BankAccount {
  id            String   @id @default(uuid())
  bankName      String
  bankCode      String? // PICHINCHA | GUAYAQUIL | BCP
  accountType   String? // SAVINGS | CHECKING
  cci           String? // Código de Cuenta Interbancario para Perú
  countryId     String
  accountName   String
  accountNumber String   @unique
  currency      String
  balance       Decimal  @default(0) @db.Decimal(18, 2)
  active        Boolean  @default(true)
  createdAt     DateTime @default(now())

  country          Country           @relation(fields: [countryId], references: [id])
  transactions     BankTransaction[]
  expenses         Expense[]
  transfersFrom    AccountTransfer[] @relation("TransferFromBank")
  transfersTo      AccountTransfer[] @relation("TransferToBank")
  capitalMovements CapitalMovement[]
  payrollPayments  PayrollPayment[]
  bankStatements   BankStatement[]
}

model BankTransaction {
  id            String   @id @default(uuid())
  bankAccountId String
  externalRef   String?
  amount        Decimal  @db.Decimal(18, 2)
  currency      String
  description   String?
  postedAt      DateTime @default(now())
  createdAt     DateTime @default(now())

  bankAccount BankAccount @relation(fields: [bankAccountId], references: [id])
}

model BankStatement {
  id               String   @id @default(uuid())
  bankAccountId    String
  fileName         String
  totalDeposits    Decimal  @default(0) @db.Decimal(18, 2)
  totalWithdrawals Decimal  @default(0) @db.Decimal(18, 2)
  linesCount       Int      @default(0)
  matchedCount     Int      @default(0)
  status           String   @default("PENDING") // PENDING | PARTIALLY_MATCHED | RECONCILED
  uploadedAt       DateTime @default(now())

  bankAccount BankAccount         @relation(fields: [bankAccountId], references: [id])
  lines       BankStatementLine[]

  @@index([bankAccountId])
}

model BankStatementLine {
  id              String   @id @default(uuid())
  bankStatementId String
  date            DateTime
  description     String
  reference       String?
  amount          Decimal  @db.Decimal(18, 2)
  type            String   // DEPOSIT | WITHDRAWAL
  matched         Boolean  @default(false)
  matchedType     String?  // TRANSFER | EXPENSE | CAPITAL | MANUAL
  matchedRef      String?  // TRX-XXXX or EXP-XXXX or CAP-XXXX
  createdAt       DateTime @default(now())

  bankStatement BankStatement @relation(fields: [bankStatementId], references: [id], onDelete: Cascade)

  @@index([bankStatementId])
}

model CashAccount {
  id                     String   @id @default(uuid())
  code                   String   @unique // MAIN-EC-01
  officeId               String
  currency               String
  balance                Decimal  @default(0) @db.Decimal(18, 2)
  maxBalance             Decimal? @db.Decimal(18, 2) // Límite de seguridad de saldo máximo en caja
  requiresSupervisorAbove Decimal? @db.Decimal(18, 2) // Monto a partir del cual se exige PIN/Rol de supervisor
  active                 Boolean  @default(true)
  createdAt              DateTime @default(now())

  office           Office            @relation(fields: [officeId], references: [id])
  movements        CashMovement[]
  sessions         CashSession[]
  expenses         Expense[]
  transfersFrom    AccountTransfer[] @relation("TransferFromCash")
  transfersTo      AccountTransfer[] @relation("TransferToCash")
  capitalMovements CapitalMovement[]
  payrollPayments  PayrollPayment[]
}

// ============ PROVEEDORES Y PERSONAL ============

model Supplier {
  id                String   @id @default(uuid())
  name              String   // Razón Social o Nombre
  taxId             String?  // RUC / DNI / CI
  countryId         String
  category          String   @default("OTHER") // RENT | UTILITIES | SERVICES | SOFTWARE | SUPPLIES | MARKETING | OTHER
  phone             String?
  email             String?
  address           String?
  bankName          String?
  bankAccountNumber String?
  notes             String?
  active            Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  country  Country   @relation(fields: [countryId], references: [id])
  expenses Expense[]

  @@index([countryId])
}

model Employee {
  id                String       @id @default(uuid())
  fullName          String
  documentType      DocumentType @default(CEDULA)
  documentNumber    String
  countryId         String
  position          String       // Cajero, Administrador, Supervisor, Contador, etc.
  baseSalary        Decimal      @db.Decimal(18, 2)
  salaryCurrency    String       @default("USD") // USD | PEN
  paymentFrequency  String       @default("MONTHLY") // MONTHLY | BIWEEKLY
  bankName          String?
  bankAccountNumber String?
  phone             String?
  email             String?
  hiredAt           DateTime     @default(now())
  active            Boolean      @default(true)
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  country         Country          @relation(fields: [countryId], references: [id])
  payrollPayments PayrollPayment[]

  @@unique([documentType, documentNumber])
}

model PayrollPayment {
  id                String   @id @default(uuid())
  payrollNumber     String   @unique // PAY-202608-0001
  employeeId        String
  amount            Decimal  @db.Decimal(18, 2)
  currency          String   // USD | PEN
  period            String   // p. ej. "Agosto 2026", "1ra Quincena Agosto 2026"
  paymentSourceType String   // BANK | CASH
  bankAccountId     String?
  cashAccountId     String?
  paidAt            DateTime @default(now())
  receiptUrl        String?  // Comprobante adjunto
  notes             String?
  entryGroupId      String?  // Referencia al asiento en LedgerEntry
  createdById       String?
  createdAt         DateTime @default(now())

  employee    Employee     @relation(fields: [employeeId], references: [id])
  bankAccount BankAccount? @relation(fields: [bankAccountId], references: [id])
  cashAccount CashAccount? @relation(fields: [cashAccountId], references: [id])
  createdBy   User?        @relation("PayrollPaymentCreatedBy", fields: [createdById], references: [id])

  @@index([employeeId])
  @@index([paidAt])
}

// ============ GASTOS Y CONTABILIDAD FINANCIERA ============

model Expense {
  id                String   @id @default(uuid())
  expenseNumber     String   @unique // EXP-202608-0001
  category          String   // RENT | UTILITIES | PAYROLL | BANK_FEES | SOFTWARE_HOSTING | OFFICE_SUPPLIES | MARKETING | TAXES | OTHER
  supplierId        String?
  supplierName      String
  supplierTaxId     String?  // RUC / DNI / CI
  invoiceNumber     String?  // N° de Factura / Boleta / Comprobante
  currency          String   // USD | PEN
  subtotal          Decimal  @db.Decimal(18, 2)
  taxRate           Decimal  @default(0) @db.Decimal(5, 2) // 15.00 o 18.00 o 0.00
  taxAmount         Decimal  @default(0) @db.Decimal(18, 2)
  total             Decimal  @db.Decimal(18, 2)
  paymentSourceType String   // BANK | CASH
  bankAccountId     String?
  cashAccountId     String?
  paidAt            DateTime @default(now())
  receiptUrl        String?  // Archivo / Foto del comprobante (data URL)
  notes             String?
  entryGroupId      String?  // Referencia al asiento contable en LedgerEntry
  createdById       String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  supplier    Supplier?    @relation(fields: [supplierId], references: [id])
  bankAccount BankAccount? @relation(fields: [bankAccountId], references: [id])
  cashAccount CashAccount? @relation(fields: [cashAccountId], references: [id])
  createdBy   User?        @relation("ExpenseCreatedBy", fields: [createdById], references: [id])

  @@index([category])
  @@index([paidAt])
}

model AccountTransfer {
  id                String   @id @default(uuid())
  transferNumber    String   @unique // TRF-202608-0001
  fromType          String   // BANK | CASH
  fromBankAccountId String?
  fromCashAccountId String?
  toType            String   // BANK | CASH
  toBankAccountId   String?
  toCashAccountId   String?
  amount            Decimal  @db.Decimal(18, 2)
  currency          String   // USD | PEN
  reference         String?  // Comprobante / N° Operación bancaria
  receiptUrl        String?  // Foto / comprobante
  description       String?
  transferredAt     DateTime @default(now())
  createdById       String?
  createdAt         DateTime @default(now())

  fromBankAccount BankAccount? @relation("TransferFromBank", fields: [fromBankAccountId], references: [id])
  fromCashAccount CashAccount? @relation("TransferFromCash", fields: [fromCashAccountId], references: [id])
  toBankAccount   BankAccount? @relation("TransferToBank", fields: [toBankAccountId], references: [id])
  toCashAccount   CashAccount? @relation("TransferToCash", fields: [toCashAccountId], references: [id])
  createdBy       User?        @relation("AccountTransferCreatedBy", fields: [createdById], references: [id])

  @@index([transferredAt])
}

model CapitalMovement {
  id              String   @id @default(uuid())
  movementNumber  String   @unique // CAP-202608-0001
  type            String   // INJECTION | WITHDRAWAL
  destinationType String   // BANK | CASH
  bankAccountId   String?
  cashAccountId   String?
  amount          Decimal  @db.Decimal(18, 2)
  currency        String   // USD | PEN
  partnerName     String?  // Nombre del socio o aportante
  concept         String?  // Concepto / Motivo
  receiptUrl      String?  // Comprobante adjunto
  createdById     String?
  createdAt       DateTime @default(now())

  bankAccount BankAccount? @relation(fields: [bankAccountId], references: [id])
  cashAccount CashAccount? @relation(fields: [cashAccountId], references: [id])
  createdBy   User?        @relation("CapitalMovementCreatedBy", fields: [createdById], references: [id])

  @@index([createdAt])
}

model CashMovement {
  id            String           @id @default(uuid())
  cashAccountId String
  cashSessionId String?
  type          CashMovementType
  amount        Decimal          @db.Decimal(18, 2)
  currency      String
  description   String?
  performedById String?
  transferId    String?
  createdAt     DateTime         @default(now())

  cashAccount CashAccount @relation(fields: [cashAccountId], references: [id])
  cashSession CashSession? @relation(fields: [cashSessionId], references: [id])
  performedBy User?        @relation(fields: [performedById], references: [id])
  payment     Payment?     @relation("PaymentCashMovement")
  payout      Payout?      @relation("PayoutCashMovement")
}

model CashSession {
  id              String           @id @default(uuid())
  cashAccountId   String
  openedById      String
  openedAt        DateTime         @default(now())
  openingBalance  Decimal          @db.Decimal(18, 2)
  expectedBalance Decimal?         @db.Decimal(18, 2)
  actualBalance   Decimal?         @db.Decimal(18, 2)
  discrepancy     Decimal?         @db.Decimal(18, 2)
  status          CashSessionStatus @default(OPEN)
  closedById      String?
  closedAt        DateTime?
  note            String?
  createdAt       DateTime         @default(now())

  cashAccount CashAccount   @relation(fields: [cashAccountId], references: [id])
  openedBy    User          @relation("SessionOpenedBy", fields: [openedById], references: [id])
  closedBy    User?         @relation("SessionClosedBy", fields: [closedById], references: [id])
  movements   CashMovement[]
}

// ============ RISK / AML ============

model RiskAssessment {
  id         String   @id @default(uuid())
  transferId String
  score      Int      @default(0)
  level      String   @default("LOW") // LOW | MEDIUM | HIGH
  reasons    Json?
  createdAt  DateTime @default(now())

  transfer Transfer @relation(fields: [transferId], references: [id])
}

model RiskAlert {
  id         String   @id @default(uuid())
  customerId String
  type       String // UNUSUAL_PATTERN | NEW_BENEFICIARY | HIGH_AMOUNT | THIRD_PARTY_PAYMENT | ETC
  severity   String   @default("LOW")
  detail     String?
  resolved   Boolean  @default(false)
  createdAt  DateTime @default(now())

  customer Customer @relation(fields: [customerId], references: [id])
}

model AmlCase {
  id         String   @id @default(uuid())
  customerId String
  status     String   @default("OPEN") // OPEN | MANUAL_REVIEW | CLOSED | BLOCKED
  riskLevel  String   @default("MEDIUM")
  summary    String?
  assignedTo String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  customer Customer @relation(fields: [customerId], references: [id])
}

// ============ AUDITORÍA ============

model AuditLog {
  id        String      @id @default(uuid())
  actorId   String
  action    AuditAction
  entity    String
  entityId  String?
  before    Json?
  after     Json?
  ip        String?
  createdAt DateTime    @default(now())

  actor User @relation(fields: [actorId], references: [id])

  @@index([entity, entityId])
  @@index([actorId])
}

// ============ COMISIONES / TARIFAS ============

model FeeTier {
  id                String             @id @default(uuid())
  minAmountPen      Decimal            @db.Decimal(18, 2)
  maxAmountPen      Decimal            @db.Decimal(18, 2)
  feeUsd            Decimal            @db.Decimal(18, 2)
  feePen            Decimal?           @db.Decimal(18, 2)
  corridorDirection CorridorDirection?
  description       String?
  active            Boolean            @default(true)
  orderIndex        Int                @default(0)
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  @@index([active, minAmountPen, maxAmountPen])
}

